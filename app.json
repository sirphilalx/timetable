{
  "expo": {
    "name": "TT",
    "slug": "tt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo/Logo-light.png",
    "scheme": "tt",
    "jsEngine": "hermes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.studenttimetable.tt",
      "associatedDomains": ["applinks:studenttimetable.app"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "NSCameraUsageDescription": "TT uses your camera to scan class QR codes shared by your course rep and take an optional student profile photo."
      }
    },
    "android": {
      "package": "app.studenttimetable.tt",
      "adaptiveIcon": {
        "foregroundImage": "./logo/Logo-light.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "CAMERA",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "studenttimetable.app",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "studenttimetable.app",
              "pathPrefix": "/consent"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "TT uses your camera to scan class QR codes shared by your course rep and take an optional student profile photo.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./logo/Logo-light.png",
          "color": "#4F46E5"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./logo/Logo-light.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "23de588a-bd17-4640-9600-d679225f2d6b"
      }
    },
    "owner": "sirphil01"
  }
}
